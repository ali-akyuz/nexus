# ─────────────────────────────────────────────────────────────────────────────
# NEXUS — Environment Configuration Template
#
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────────────────────
NODE_ENV=development
APP_NAME=nexus
APP_VERSION=0.1.0

# ── API Service (NestJS) ──────────────────────────────────────────────────────
API_PORT=3001
API_HOST=0.0.0.0
API_BASE_URL=http://localhost:3001

# ── Frontend (Next.js) ───────────────────────────────────────────────────────
WEB_PORT=3000
# Browser accessible URLs (Public)
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_WS_URL=ws://localhost:3001
# Internal container-to-container URL (Server)
API_URL=http://api:3001

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=nexus
POSTGRES_USER=nexus_user
POSTGRES_PASSWORD=change_me_in_production
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}?schema=public

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}

# ── JWT Authentication ────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=replace_with_a_strong_random_secret_min_64_chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_SECRET=replace_with_a_different_strong_random_secret_min_64_chars
JWT_REFRESH_EXPIRY=7d

# ── Python ML Service (FastAPI) ───────────────────────────────────────────────
ML_SERVICE_PORT=8000
ML_SERVICE_HOST=localhost
ML_SERVICE_URL=http://localhost:8000
ML_SERVICE_API_KEY=replace_with_internal_service_api_key

# ── Worker Settings ───────────────────────────────────────────────────────────
WORKER_CONCURRENCY=5
WORKER_HEARTBEAT_INTERVAL_MS=10000
WORKER_STALE_THRESHOLD_MS=30000

# ── BullMQ Queue Settings ─────────────────────────────────────────────────────
QUEUE_DEFAULT_ATTEMPTS=3
QUEUE_DEFAULT_BACKOFF_TYPE=exponential
QUEUE_DEFAULT_BACKOFF_DELAY_MS=2000
QUEUE_JOB_TIMEOUT_MS=300000

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=debug
LOG_FORMAT=json

# ── Observability ─────────────────────────────────────────────────────────────
METRICS_ENABLED=true
METRICS_PORT=9090

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000

# ── File Uploads ──────────────────────────────────────────────────────────────
UPLOAD_MAX_SIZE_MB=100
UPLOAD_DIR=./uploads
