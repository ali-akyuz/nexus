{
  "name": "@repo/worker-processor",
  "version": "0.1.0",
  "private": true,
  "description": "NEXUS Processor Worker — consumes default, ml-processing, and ai-processing queues",
  "scripts": {
    "build": "tsc",
    "dev": "ts-node -r tsconfig-paths/register src/main.ts",
    "start": "node dist/main",
    "type-check": "tsc --noEmit",
    "lint": "eslint src/",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@nestjs/bullmq": "^11.0.5",
    "@nestjs/common": "^10.4.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^10.4.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.79.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@prisma/client": "^6.0.0",
    "@repo/config": "workspace:*",
    "@repo/types": "workspace:*",
    "@willsoto/nestjs-prometheus": "^6.1.0",
    "bullmq": "^6.1.2",
    "ioredis": "^6.0.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@types/node": "^22.5.4",
    "rimraf": "^6.0.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.5.0"
  }
}
